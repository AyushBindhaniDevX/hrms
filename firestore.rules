rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isHR() {
      return isAuthenticated() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'hr';
    }

    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles
    match /profiles/{userId} {
      allow read: if isAuthenticated(); // Directory needs access
      allow update: if isOwner(userId) || isHR() || isAdmin();
      allow create: if isOwner(userId) || isHR() || isAdmin();
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }

    // Attendance
    match /attendance/{docId} {
      // Employees can read their own attendance, HR/Admin can read all
      allow read: if isAuthenticated(); 
      // Employees can only clock in/out for themselves
      allow create, update: if isAuthenticated() && request.resource.data.employee_id == get(/databases/$(database)/documents/employees/$(docId.split('_')[0])).id || isHR() || isAdmin();
    }

    // Leave Types, Workplaces, Departments, Organizations
    match /leave_types/{docId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }
    match /workplaces/{docId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }
    match /departments/{docId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }
    match /organizations/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Leave Balances & Requests
    match /leave_balances/{docId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }
    match /leave_requests/{docId} {
      allow read: if isAuthenticated();
      // Employees can create requests, HR can approve/reject
      allow create: if isAuthenticated() && request.resource.data.employee_id == get(/databases/$(database)/documents/employees/$(request.auth.uid)).id;
      allow update: if isHR() || isAdmin() || (isOwner(resource.data.employee_id) && request.resource.data.status == 'cancelled');
    }

    // Payroll
    match /payroll_periods/{docId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }
    match /payroll/{docId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }
    match /payslips/{docId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }

    // Audit Logs
    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isHR() || isAdmin();
    }
  }
}
